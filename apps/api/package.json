{
  "name": "@chargeroad/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:db": "node scripts/test-db.cjs",
    "validate:planning": "ts-node src/planning/validation/run-validation.ts",
    "db:migrate": "ts-node src/cli.ts db:migrate",
    "security:cleanup": "ts-node src/cli.ts security:cleanup",
    "vehicles:import": "ts-node src/cli.ts vehicles:import",
    "vehicles:publish": "ts-node src/cli.ts vehicles:publish",
    "stations:sync-epdk": "ts-node src/cli.ts stations:sync-epdk",
    "stations:sync": "ts-node src/cli.ts stations:sync",
    "stations:sources": "ts-node src/cli.ts stations:sources",
    "stations:rebuild": "ts-node src/cli.ts stations:rebuild",
    "roads:validate": "ts-node scripts/validate-roads.ts",
    "stations:import-epdk": "ts-node src/cli.ts stations:import-epdk",
    "stations:publish": "ts-node src/cli.ts stations:publish",
    "stations:benchmark": "ts-node scripts/benchmark-stations.ts",
    "vehicles:stage-kilowatt": "ts-node src/cli.ts vehicles:stage-kilowatt",
    "vehicles:sync-kilowatt": "ts-node src/cli.ts vehicles:sync-kilowatt",
    "vehicles:benchmark": "ts-node scripts/benchmark-knowledge.ts",
    "vehicles:report": "ts-node scripts/report-knowledge.ts",
    "test:integration": "jest --runInBand --cache=false integration.spec",
    "roads:benchmark": "ts-node scripts/benchmark-roads.ts",
    "roads:cleanup": "ts-node scripts/cleanup-roads.ts"
  },
  "dependencies": {
    "@chargeroad/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
