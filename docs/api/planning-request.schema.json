{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "origin": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    },
    "vehicleVariantId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "departureAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "startingChargePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "startingChargeObservedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "minimumReserveChargePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "targetArrivalChargePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "minimumReserveChargePercent",
        "targetArrivalChargePercent"
      ],
      "additionalProperties": false
    },
    "objective": {
      "default": "minimum_total_duration",
      "type": "string",
      "enum": [
        "minimum_total_duration",
        "minimum_energy",
        "minimum_charging_stops"
      ]
    },
    "vehicleDataQuality": {
      "default": "verified_only",
      "type": "string",
      "enum": [
        "verified_only",
        "allow_engineering_estimates"
      ]
    },
    "initialBatteryTemperatureC": {
      "default": {
        "origin": "unknown",
        "value": null
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "user_input"
            },
            "value": {
              "type": "number"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "origin",
            "value",
            "observedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "origin",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "stateOfHealthPercent": {
      "default": {
        "origin": "unknown",
        "value": null
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "user_input"
            },
            "value": {
              "type": "number"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "origin",
            "value",
            "observedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "const": "unknown"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "origin",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "operatingConditions": {
      "default": {
        "payloadKg": {
          "origin": "unknown",
          "value": null
        },
        "cabinTargetTemperatureC": {
          "origin": "unknown",
          "value": null
        },
        "hvacMode": "unknown",
        "batteryPreconditioning": "unknown",
        "tireSetupId": null
      },
      "type": "object",
      "properties": {
        "payloadKg": {
          "default": {
            "origin": "unknown",
            "value": null
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string",
                  "const": "user_input"
                },
                "value": {
                  "type": "number"
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "origin",
                "value",
                "observedAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string",
                  "const": "unknown"
                },
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "origin",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "cabinTargetTemperatureC": {
          "default": {
            "origin": "unknown",
            "value": null
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string",
                  "const": "user_input"
                },
                "value": {
                  "type": "number"
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "origin",
                "value",
                "observedAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string",
                  "const": "unknown"
                },
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "origin",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "hvacMode": {
          "default": "unknown",
          "type": "string",
          "enum": [
            "off",
            "heat",
            "cool",
            "auto",
            "unknown"
          ]
        },
        "batteryPreconditioning": {
          "default": "unknown",
          "type": "string",
          "enum": [
            "requested",
            "off",
            "unknown"
          ]
        },
        "tireSetupId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "roadPreferences": {
      "default": {
        "avoidTolls": false,
        "avoidFerries": true
      },
      "type": "object",
      "properties": {
        "avoidTolls": {
          "default": false,
          "type": "boolean"
        },
        "avoidFerries": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "origin",
    "destination",
    "vehicleVariantId",
    "departureAt",
    "startingChargePercent",
    "startingChargeObservedAt",
    "constraints"
  ],
  "additionalProperties": false
}
