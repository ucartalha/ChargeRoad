DATABASE_URL=postgresql://chargeroad:chargeroad@localhost:5432/chargeroad
API_PORT=3000
HERE_API_KEY=
OPEN_CHARGE_MAP_API_KEY=
# Optional absolute path to a reviewed station provider policy JSON. Rebuild catalogue after changing it.
STATION_SOURCE_POLICY_FILE=
# Local development road pilot only. Public demos are refused when NODE_ENV=production.
ROAD_ROUTING_PILOT_ENABLED=false
ROAD_ROUTING_PROVIDER_ID=valhalla-self-hosted
ROAD_ROUTING_BASE_URL=http://127.0.0.1:8004
# Optional: external or self_hosted. Loopback Valhalla defaults to self_hosted.
# Keep actual runtime .env unchanged when validating a separate DEM pilot.
ROAD_ROUTING_DEPLOYMENT_MODE=self_hosted
ROAD_ROUTING_ENGINE_VERSION=3.9.1
ROAD_ROUTING_GRAPH_VERSION=unknown
ROAD_ROUTING_DEM_VERSION=unknown
ROAD_ROUTING_CACHE_REVISION=unknown
# Self-hosted safety ceiling only; blank means pacing/admission, no external daily quota.
ROAD_ROUTING_SELF_HOSTED_DAILY_SAFETY_LIMIT=
# Backend only; never put provider credentials in EXPO_PUBLIC variables.
GEOAPIFY_API_KEY=
ROAD_OSM_TAGS_ENABLED=false
ROAD_OSM_TAGS_URL=https://overpass-api.de/api/interpreter
# Weather requests remain off until an authorized human accepts MET terms and supplies real contact details.
WEATHER_ENABLED=false
WEATHER_PROVIDER_ID=met-norway
WEATHER_MET_TERMS_ACCEPTED=false
WEATHER_USER_AGENT=
WEATHER_MET_ENDPOINT=https://api.met.no/weatherapi/locationforecast/2.0/compact
# Pin imports for reproducibility; use --version latest for an explicit refresh.
VEHICLE_DATA_VERSION=v1.24.0
# Required for the HTTP API. Use the SAME random secret on every API instance.
# Generate, for example, with Node crypto.randomBytes(32).toString('hex').
RATE_LIMIT_IP_HASH_SECRET=
RATE_LIMIT_DAY_TIMEZONE=Europe/Istanbul
RATE_LIMIT_DAILY_STRIKES=3
RATE_LIMIT_CATALOGUE_PER_MINUTE=120
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PLANNING_PER_MINUTE=6
RATE_LIMIT_MAX_PENDING=32
# Planning admission is shared in PostgreSQL; global capacity defaults to 4 in migration 011.
PLANNING_HTTP_BUDGET_MS=30000
PLANNING_JOB_BUDGET_MS=120000
PLANNING_LOCAL_CONCURRENCY=2
# Comma-separated IPs/CIDRs for the actual reverse proxies. Empty = no forwarded headers trusted.
TRUSTED_PROXY_CIDRS=
# Address search development pilot. Public Photon is blocked in production; use an approved/self-hosted endpoint.
GEOCODING_ENABLED=true
GEOCODING_PROVIDER_ID=photon
GEOCODING_BASE_URL=https://photon.komoot.io
