DATABASE_URL=postgresql://chargeroad:chargeroad@localhost:5432/chargeroad
API_PORT=3000
HERE_API_KEY=
OPEN_CHARGE_MAP_API_KEY=
# Pin imports for reproducibility; use --version latest for an explicit refresh.
VEHICLE_DATA_VERSION=v1.24.0
# Required for the HTTP API. Use the SAME random secret on every API instance.
# Generate, for example, with Node crypto.randomBytes(32).toString('hex').
RATE_LIMIT_IP_HASH_SECRET=
RATE_LIMIT_DAY_TIMEZONE=Europe/Istanbul
RATE_LIMIT_DAILY_STRIKES=3
RATE_LIMIT_CATALOGUE_PER_MINUTE=120
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_MAX_PENDING=32
# Comma-separated IPs/CIDRs for the actual reverse proxies. Empty = no forwarded headers trusted.
TRUSTED_PROXY_CIDRS=
